---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import Crumbs from './Crumbs.astro';
import { breadcrumbLd } from '../lib/crumbs';

// ゲームの一覧とカテゴリの一覧の共通の形（パンくず・見出し・カード）
interface Props {
  title: string;
  kicker: string;
  hue: number;
  posts: CollectionEntry<'posts'>[];
  crumbs: { name: string; href?: string }[];
  self: string;
  /** その下のカテゴリへのリンク（ゲームの一覧だけ） */
  sections?: { name: string; href: string; count: number }[];
}
const { title, kicker, hue, posts, crumbs, self, sections = [] } = Astro.props;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: title, url: new URL(self, Astro.site).href, inLanguage: 'ja' },
    breadcrumbLd(crumbs, self, Astro.site),
  ],
};
---

<Base title={title} description={`ハジエッセイの「${title}」の記事 ${posts.length} 本`} jsonld={jsonld}>
  <Crumbs items={crumbs} wide />
  <header class="list-head" style={`--hue:${hue}`}>
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    <p class="count">{posts.length} POSTS</p>
    {sections.length > 0 && (
      <ul class="sections">
        {sections.map((s) => <li><a href={s.href}>#{s.name} <small>{s.count}</small></a></li>)}
      </ul>
    )}
  </header>
  <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
</Base>

<style>
  .list-head {
    margin: 14px 0 24px; padding: 22px 26px; border-radius: 20px; border: 1px solid var(--line);
    background: linear-gradient(160deg, hsl(var(--hue) 70% 22%), #111116 70%);
  }
  .kicker { margin: 0; font-family: var(--hud); letter-spacing: 0.2em; font-size: 0.78rem; color: hsl(var(--hue) var(--sat) 72%); }
  h1 { margin: 6px 0 4px; font-size: clamp(1.4rem, 4vw, 2rem); }
  .count { margin: 0; font-family: var(--hud); letter-spacing: 0.16em; font-size: 0.8rem; color: var(--muted); }
  .sections { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; }
  .sections a { display: inline-block; padding: 5px 12px; border-radius: 999px; background: rgb(0 0 0 / 30%); color: var(--fg); text-decoration: none; font-size: 0.85rem; }
  .sections small { color: var(--muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
</style>
