---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { gameOf, excerpt } from '../lib/games';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const game = gameOf(post.id);
const base = import.meta.env.BASE_URL;
const d = post.data.pubDate;
const date = d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('/', '.');
---

<article
  class:list={['card', { featured }]}
  style={`--hue:${game.hue};--mascot:url(${base}favicon.svg)`}
  data-game={game.key}
  data-cats={post.data.categories.join('|')}
  data-title={post.data.title}
>
  <a href={`${base}${post.id}/`} class="card-link">
    <div class="thumb">
      {post.data.cover ? (
        <Image src={post.data.cover} alt="" width={featured ? 960 : 520} loading={featured ? 'eager' : 'lazy'} />
      ) : (
        <span class="thumb-fallback">{game.short}</span>
      )}
      <span class="game-badge on-image">{game.short}</span>
    </div>
    <div class="body">
      <time class="date" datetime={d.toISOString()}>{date}</time>
      <h3>{post.data.title}</h3>
      <p class="excerpt">{excerpt(post.body, featured ? 120 : 60)}</p>
      {featured && <span class="read">READ MORE →</span>}
    </div>
  </a>
</article>

<style>
  .card {
    position: relative;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--hue) var(--sat) var(--light) / 55%);
    box-shadow: var(--shadow), 0 0 0 1px hsl(var(--hue) var(--sat) var(--light) / 25%), 0 18px 40px hsl(var(--hue) 90% 50% / 18%);
  }
  .card-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .thumb {
    position: relative; aspect-ratio: 4 / 3; overflow: hidden;
    background:
      linear-gradient(135deg, hsl(var(--hue) 85% 45% / 85%), hsl(calc(var(--hue) - 20) 70% 18%)),
      repeating-linear-gradient(45deg, rgb(255 255 255 / 6%) 0 2px, transparent 2px 10px);
    display: grid; place-items: center;
  }
  .thumb :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: top; display: block;
    transition: transform 0.5s ease, filter 0.3s ease; filter: saturate(0.95) brightness(0.92);
  }
  .card:hover .thumb :global(img) { transform: scale(1.04); filter: saturate(1.05) brightness(1); }
  /* 画像の下を暗くして、カードの本文へつなぐ */
  .thumb::after { content: ''; position: absolute; inset: auto 0 0 0; height: 45%; background: linear-gradient(transparent, rgb(11 11 14 / 70%)); pointer-events: none; }
  /* 画像の無い記事は、うさぎとゲーム名の板にする */
  .thumb-fallback {
    width: 100%; height: 100%; display: grid; place-items: end center; padding-bottom: 12%; box-sizing: border-box;
    background: var(--mascot) no-repeat center 32% / 34%;
  }
  .thumb-fallback { font-family: 'Dela Gothic One', sans-serif; color: rgb(255 255 255 / 88%); font-size: 1.5rem; letter-spacing: 0.1em; }
  .on-image { position: absolute; top: 10px; left: 10px; z-index: 1; background: rgb(11 11 14 / 70%); backdrop-filter: blur(6px); }
  .body { padding: 14px 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .date { font-family: var(--hud); font-size: 0.74rem; font-weight: 500; letter-spacing: 0.14em; color: hsl(var(--hue) var(--sat) var(--light)); }
  h3 { margin: 0; font-size: 0.98rem; line-height: 1.55; font-weight: 700; }
  .excerpt {
    margin: 0; font-size: 0.8rem; color: var(--muted); line-height: 1.7;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }

  /* いちばん新しい記事は、画像の上に文字を重ねた大きいカード */
  .featured .thumb { aspect-ratio: 21 / 9; }
  .featured .thumb::after { height: 100%; background: linear-gradient(90deg, rgb(11 11 14 / 92%) 0%, rgb(11 11 14 / 55%) 45%, transparent 75%); }
  .featured .body { position: absolute; inset: 0 auto 0 0; width: min(560px, 62%); justify-content: center; padding: 28px 32px; z-index: 1; }
  .featured h3 { font-size: clamp(1.25rem, 2.6vw, 1.75rem); line-height: 1.4; }
  .featured .excerpt { font-size: 0.9rem; color: #c9c7d3; -webkit-line-clamp: 3; line-clamp: 3; }
  .read { margin-top: 6px; font-family: var(--hud); font-weight: 700; font-size: 0.78rem; letter-spacing: 0.18em; color: hsl(var(--hue) var(--sat) var(--light)); }
  @media (max-width: 720px) {
    .featured .thumb { aspect-ratio: 4 / 3; }
    .featured .thumb::after { background: linear-gradient(transparent 20%, rgb(11 11 14 / 95%) 85%); }
    .featured .body { inset: auto 0 0 0; width: auto; padding: 18px; }
    .featured .excerpt { display: none; }
  }
</style>
