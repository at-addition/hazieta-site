---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { gameOf, excerpt } from '../lib/games';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
  // 前後の記事は同じゲームの中でたどる
  return posts.map((post) => {
    const same = posts.filter((p) => gameOf(p.id).key === gameOf(post.id).key);
    const i = same.indexOf(post);
    return { params: { slug: post.id }, props: { post, prev: same[i - 1], next: same[i + 1] } };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const game = gameOf(post.id);
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).replaceAll('/', '.');
// 見出しの背景に、記事の最初の画像をぼかして敷く
const cover = post.data.cover ? await getImage({ src: post.data.cover, width: 800 }) : undefined;
---

<Base title={post.data.title} description={excerpt(post.body, 110)}>
  <div class="progress" aria-hidden="true"><span></span></div>
  <article class="post" style={`--hue:${game.hue}`}>
    <header class="post-head">
      {cover && <div class="head-bg" style={`background-image:url(${cover.src})`} aria-hidden="true"></div>}
      <div class="head-inner">
        <div class="meta">
          <a class="game-badge" href={`${base}?game=${game.key}`}>{game.short}</a>
          {post.data.categories.map((c) => <span class="chip">#{c}</span>)}
        </div>
        <h1>{post.data.title}</h1>
        <p class="date">
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          {post.data.updatedDate && <span> / UPDATE {fmt(post.data.updatedDate)}</span>}
        </p>
      </div>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="同じゲームの前後の記事" style={`--hue:${game.hue}`}>
    {prev ? (
      <a class="prev" href={`${base}${prev.id}/`}><small>← PREV</small><span>{prev.data.title}</span></a>
    ) : <span />}
    {next ? (
      <a class="next" href={`${base}${next.id}/`}><small>NEXT →</small><span>{next.data.title}</span></a>
    ) : <span />}
  </nav>
  <p class="back"><a href={base}>← 記事の一覧へ</a></p>
</Base>

<script>
  // 読んだところまでを上の細い線で見せる
  const bar = document.querySelector<HTMLElement>('.progress span');
  const update = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    if (bar) bar.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 20; pointer-events: none; }
  .progress span {
    display: block; height: 100%; transform-origin: 0 50%; transform: scaleX(0);
    background: linear-gradient(90deg, hsl(18 95% 58%), hsl(285 90% 65%));
    box-shadow: 0 0 10px hsl(18 95% 58% / 70%);
  }

  .post { max-width: 800px; margin: 32px auto 0; }
  .post-head {
    position: relative; overflow: hidden; border-radius: 20px; border: 1px solid var(--line);
    margin-bottom: 22px; background: linear-gradient(160deg, hsl(var(--hue) 70% 22%), #111116 70%);
  }
  .head-bg {
    position: absolute; inset: -20px; background-size: cover; background-position: center;
    filter: blur(18px) saturate(1.2) brightness(0.45); transform: scale(1.1);
  }
  .head-inner { position: relative; padding: clamp(24px, 5vw, 44px) clamp(18px, 5vw, 40px); }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .meta .game-badge { text-decoration: none; }
  .meta .chip { background: rgb(0 0 0 / 30%); }
  h1 { font-size: clamp(1.45rem, 4vw, 2.1rem); line-height: 1.45; margin: 14px 0 10px; font-weight: 700; text-shadow: 0 2px 16px rgb(0 0 0 / 50%); }
  .date { margin: 0; font-family: var(--hud); font-size: 0.8rem; letter-spacing: 0.16em; color: hsl(var(--hue) var(--sat) 72%); }

  .body {
    background: var(--surface); border: 1px solid var(--line); border-radius: 20px; box-shadow: var(--shadow);
    padding: 34px clamp(18px, 5vw, 52px); font-size: 1.02rem;
  }
  /* 元の記事は1行ずつ段落になっているので、段落の間を詰めて当時の見え方に寄せる */
  .body :global(p) { margin: 0.15em 0; }
  .body :global(h2) {
    position: relative; margin: 2.4em 0 0.9em; padding: 12px 16px 12px 20px; font-size: 1.2rem; line-height: 1.5;
    border-radius: 10px; background: linear-gradient(90deg, hsl(var(--hue) 85% 50% / 18%), transparent);
    border: 1px solid hsl(var(--hue) var(--sat) var(--light) / 25%);
  }
  .body :global(h2)::before {
    content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 4px; border-radius: 0 4px 4px 0;
    background: hsl(var(--hue) var(--sat) var(--light)); box-shadow: 0 0 12px hsl(var(--hue) var(--sat) var(--light));
  }
  .body :global(h3) { margin: 1.9em 0 0.6em; font-size: 1.08rem; padding-left: 12px; border-left: 3px solid hsl(var(--hue) var(--sat) var(--light) / 70%); }
  .body :global(h4) { margin: 1.4em 0 0.4em; font-size: 1rem; color: hsl(var(--hue) var(--sat) 75%); }
  .body :global(img) {
    display: block; margin: 16px auto; border-radius: 12px; width: auto; max-height: 560px;
    border: 1px solid var(--line); box-shadow: 0 10px 30px rgb(0 0 0 / 45%);
  }
  .body :global(a) { color: hsl(var(--hue) var(--sat) 70%); }
  .body :global(ul) { padding-left: 1.4em; }
  .body :global(blockquote) { margin: 1em 0; padding: 8px 16px; border-left: 3px solid var(--line); color: var(--muted); }
  .body :global(table) { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  .body :global(td), .body :global(th) { border: 1px solid var(--line); padding: 6px 8px; }

  .pager { max-width: 800px; margin: 28px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pager a {
    display: flex; flex-direction: column; gap: 4px; padding: 14px 18px; border-radius: 14px;
    background: var(--surface); border: 1px solid var(--line); color: var(--fg); text-decoration: none; font-size: 0.88rem; line-height: 1.5;
    transition: border-color 0.2s, transform 0.2s;
  }
  .pager a:hover { border-color: hsl(var(--hue) var(--sat) var(--light) / 55%); transform: translateY(-2px); }
  .pager small { font-family: var(--hud); letter-spacing: 0.16em; font-weight: 700; color: hsl(var(--hue) var(--sat) var(--light)); }
  .pager .next { text-align: right; }
  .back { max-width: 800px; margin: 24px auto 0; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } }
</style>
