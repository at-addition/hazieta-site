---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { gameOf, excerpt } from '../lib/games';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
  // 前後の記事は同じゲームの中でたどる
  return posts.map((post) => {
    const same = posts.filter((p) => gameOf(p.id).key === gameOf(post.id).key);
    const i = same.indexOf(post);
    return { params: { slug: post.id }, props: { post, prev: same[i - 1], next: same[i + 1] } };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const game = gameOf(post.id);
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={post.data.title} description={excerpt(post.body, 110)}>
  <article class="post" style={`--hue:${game.hue}`}>
    <header class="post-head">
      <div class="meta">
        <a class="game-badge" href={`${base}?game=${game.key}`}>{game.label}</a>
        {post.data.categories.map((c) => <span class="chip">#{c}</span>)}
      </div>
      <h1>{post.data.title}</h1>
      <p class="date">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {post.data.updatedDate && <span>（{fmt(post.data.updatedDate)} 更新）</span>}
      </p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>

  <nav class="pager" aria-label="同じゲームの前後の記事">
    {prev ? (
      <a class="prev" href={`${base}${prev.id}/`}><small>← 前の記事</small><span>{prev.data.title}</span></a>
    ) : <span />}
    {next ? (
      <a class="next" href={`${base}${next.id}/`}><small>次の記事 →</small><span>{next.data.title}</span></a>
    ) : <span />}
  </nav>
  <p class="back"><a href={base}>← 記事の一覧へ</a></p>
</Base>

<style>
  .post { max-width: 760px; margin: 40px auto 0; }
  .post-head { padding: 0 4px 24px; border-bottom: 3px solid hsl(var(--hue) 70% var(--light)); margin-bottom: 28px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .meta .game-badge { text-decoration: none; }
  h1 { font-size: clamp(1.4rem, 4vw, 2rem); line-height: 1.45; margin: 14px 0 8px; font-weight: 700; }
  .date { margin: 0; color: var(--muted); font-size: 0.88rem; }

  .body { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); padding: 32px clamp(18px, 5vw, 48px); }
  /* 元の記事は1行ずつ段落になっているので、段落の間を詰めて当時の見え方に寄せる */
  .body :global(p) { margin: 0.15em 0; }
  .body :global(h2) {
    margin: 2.2em 0 0.8em; padding: 10px 14px; font-size: 1.2rem; line-height: 1.5; border-radius: 10px;
    background: hsl(var(--hue) 70% var(--tint)); border-left: 5px solid hsl(var(--hue) 70% var(--light));
  }
  .body :global(h3) { margin: 1.8em 0 0.6em; font-size: 1.08rem; padding-bottom: 4px; border-bottom: 2px dotted var(--line); }
  .body :global(h4) { margin: 1.4em 0 0.4em; font-size: 1rem; }
  .body :global(img) {
    display: block; margin: 14px auto; border-radius: 10px; width: auto; max-height: 560px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 12%);
  }
  .body :global(ul) { padding-left: 1.4em; }
  .body :global(blockquote) { margin: 1em 0; padding: 8px 16px; border-left: 4px solid var(--line); color: var(--muted); }
  .body :global(table) { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  .body :global(td), .body :global(th) { border: 1px solid var(--line); padding: 6px 8px; }

  .pager { max-width: 760px; margin: 28px auto 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .pager a {
    display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; border-radius: var(--radius);
    background: var(--surface); box-shadow: var(--shadow); color: var(--fg); text-decoration: none; font-size: 0.88rem; line-height: 1.5;
  }
  .pager small { color: var(--muted); }
  .pager .next { text-align: right; }
  .back { max-width: 760px; margin: 24px auto 0; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } }
</style>
