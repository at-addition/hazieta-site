---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { GAMES, gameOf } from '../lib/games';
// 当時トップに出していた hazieta.com のロゴ。1080×360 の JPEG をなぞって SVG にした（拡大してもぼけない）
import heroLogo from '../assets/hazieta-logo.svg?raw';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [latest, ...rest] = posts;
const games = GAMES.map((g) => ({ ...g, count: posts.filter((p) => gameOf(p.id).key === g.key).length })).filter((g) => g.count > 0);
const cats = [...new Set(posts.flatMap((p) => p.data.categories))];
const first = posts[posts.length - 1]?.data.pubDate.getFullYear();
const last = latest?.data.pubDate.getFullYear();
---

<Base>
  <section class="hero">
    <h1 class="sr-only">ハジエッセイ – 要は日記</h1>
    <div class="hero-logo" role="img" aria-label="hazieta.com" set:html={heroLogo} />
    <p class="hero-lead">モンハンエクスプロアやシノアリスを遊びながら書いた、攻略メモと日記。</p>
    <dl class="hud-stats">
      <div><dt>POSTS</dt><dd>{posts.length}</dd></div>
      {games.map((g) => (
        <div style={`--hue:${g.hue}`}><dt><span class="dot"></span>{g.short}</dt><dd>{g.count}</dd></div>
      ))}
      <div><dt>YEAR</dt><dd>{first === last ? first : `${first}–${last}`}</dd></div>
    </dl>
  </section>

  {latest && (
    <section class="latest" aria-labelledby="h-latest">
      <h2 class="section-title" id="h-latest"><span>LATEST</span>いちばん新しい記事</h2>
      <PostCard post={latest} featured />
    </section>
  )}

  <section aria-labelledby="h-archive">
    <h2 class="section-title" id="h-archive"><span>ARCHIVE</span>記事の一覧</h2>
    <div class="search">
      <input type="search" class="q" placeholder="SEARCH — 記事のタイトルを検索（例: 防具 スキル）" aria-label="記事のタイトルを検索" />
    </div>
    <div class="filters" role="group" aria-label="絞り込み">
      <div class="seg" role="group" aria-label="ゲームで絞り込む">
        <button type="button" class="f-game" data-game="" aria-pressed="true">ALL <small>{posts.length}</small></button>
        {games.map((g) => (
          <button type="button" class="f-game" data-game={g.key} aria-pressed="false" style={`--hue:${g.hue}`}>
            {g.short} <small>{g.count}</small>
          </button>
        ))}
      </div>
      <div class="cats" role="group" aria-label="カテゴリで絞り込む">
        {cats.map((c) => <button type="button" class="f-cat" data-cat={c} aria-pressed="false">#{c}</button>)}
      </div>
    </div>
    <div class="grid">
      {rest.map((p) => <PostCard post={p} />)}
    </div>
    <p class="empty" hidden>この条件の記事はありません。</p>
  </section>
</Base>

<script>
  // ゲーム（?game=）とカテゴリで一覧を絞る。いちばん新しい記事のカードも同じ条件で隠す
  const params = new URLSearchParams(location.search);
  let game = params.get('game') ?? '';
  let cat = '';
  // タイトルの検索（?q=）。空白で区切った語をすべて含む記事を出す。全角・半角と大文字・小文字は区別しない
  const qInput = document.querySelector<HTMLInputElement>('.q')!;
  qInput.value = params.get('q') ?? '';
  const norm = (s: string) => s.normalize('NFKC').toLowerCase();
  const gameButtons = document.querySelectorAll<HTMLButtonElement>('.f-game');
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.f-cat');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const empty = document.querySelector<HTMLElement>('.empty')!;

  function apply() {
    gameButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.game ?? '') === game)));
    catButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    const words = norm(qInput.value).split(/\s+/).filter(Boolean);
    let shown = 0;
    cards.forEach((c) => {
      const ok = (!game || c.dataset.game === game) && (!cat || (c.dataset.cats ?? '').split('|').includes(cat))
        && words.every((w) => norm(c.dataset.title ?? '').includes(w));
      (c.closest('.latest') ?? c).toggleAttribute('hidden', !ok);
      if (ok) shown++;
    });
    empty.hidden = shown > 0;
    const url = new URL(location.href);
    game ? url.searchParams.set('game', game) : url.searchParams.delete('game');
    qInput.value.trim() ? url.searchParams.set('q', qInput.value.trim()) : url.searchParams.delete('q');
    history.replaceState(null, '', url);
  }
  gameButtons.forEach((b) => b.addEventListener('click', () => { game = b.dataset.game ?? ''; apply(); }));
  catButtons.forEach((b) => b.addEventListener('click', () => { cat = cat === b.dataset.cat ? '' : (b.dataset.cat ?? ''); apply(); }));
  qInput.addEventListener('input', apply);
  apply();
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* 当時のヘッダー画像と同じ黒地に白のロゴを、光の差す舞台に置く */
  .hero {
    position: relative; margin-top: 28px; padding: clamp(28px, 5vw, 56px) clamp(18px, 6vw, 72px) clamp(22px, 4vw, 36px);
    border-radius: 24px; border: 1px solid var(--line); overflow: hidden; text-align: center;
    background:
      radial-gradient(70% 90% at 50% 0%, hsl(18 95% 55% / 22%), transparent 70%),
      linear-gradient(180deg, #121217, #0b0b0e);
    box-shadow: var(--shadow);
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.6;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 3%) 0 1px, transparent 1px 4px);
  }
  .hero-logo { position: relative; width: min(100%, 680px); margin: 0 auto; color: #fff; filter: drop-shadow(0 0 22px hsl(18 95% 60% / 35%)); }
  .hero-logo :global(svg) { width: 100%; height: auto; display: block; }
  .hero-lead { position: relative; margin: 14px auto 0; color: var(--muted); font-size: 0.92rem; }
  .hud-stats { position: relative; display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; margin: 20px 0 0; }
  .hud-stats > div {
    min-width: 92px; padding: 8px 14px; border-radius: 10px; text-align: left;
    background: rgb(255 255 255 / 4%); border: 1px solid var(--line);
  }
  .hud-stats dt { display: flex; align-items: center; gap: 6px; font-family: var(--hud); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.18em; color: var(--muted); }
  .hud-stats dd { margin: 0; font-family: var(--hud); font-size: 1.35rem; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums; }

  .section-title {
    display: flex; align-items: baseline; gap: 12px; margin: 48px 0 16px; font-size: 0.95rem; font-weight: 700; color: var(--muted);
  }
  .section-title span { font-family: var(--hud); font-size: 1.5rem; letter-spacing: 0.14em; color: var(--fg); }
  .section-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line), transparent); align-self: center; }

  .search { margin: 0 0 14px; }
  .search input {
    width: 100%; box-sizing: border-box; font: inherit; font-size: 16px; padding: 12px 18px; border-radius: 12px;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
  }
  .search input:focus { outline: none; border-color: hsl(18 95% 58%); box-shadow: 0 0 0 3px hsl(18 95% 58% / 25%); }
  .filters { display: flex; flex-direction: column; gap: 12px; margin-bottom: 22px; }
  .seg { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 12px; background: rgb(255 255 255 / 3%); border: 1px solid var(--line); align-self: flex-start; }
  .filters button { font-family: inherit; line-height: inherit; cursor: pointer; color: var(--fg); background: transparent; border: 1px solid transparent; }
  .f-game { font-family: var(--hud); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; padding: 6px 14px; border-radius: 9px; }
  .f-game small { color: var(--muted); margin-left: 4px; font-weight: 500; }
  .f-game[aria-pressed='true'] { background: rgb(255 255 255 / 10%); border-color: rgb(255 255 255 / 14%); }
  .f-game[style][aria-pressed='true'] { background: hsl(var(--hue) 85% 50% / 22%); border-color: hsl(var(--hue) var(--sat) var(--light) / 60%); color: hsl(var(--hue) var(--sat) 75%); }
  .cats { display: flex; flex-wrap: wrap; gap: 6px; }
  .f-cat { font-size: 0.76rem; padding: 2px 10px; border-radius: 6px; color: var(--muted) !important; border-color: var(--line) !important; }
  .f-cat:hover { color: var(--fg) !important; }
  .f-cat[aria-pressed='true'] { background: var(--fg); color: var(--bg) !important; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
  .empty { color: var(--muted); text-align: center; padding: 40px 0; }
</style>
