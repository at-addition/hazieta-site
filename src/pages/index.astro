---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { GAMES, gameOf } from '../lib/games';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [latest, ...rest] = posts;
const games = GAMES.map((g) => ({ ...g, count: posts.filter((p) => gameOf(p.id).key === g.key).length })).filter((g) => g.count > 0);
const cats = [...new Set(posts.flatMap((p) => p.data.categories))];
const first = posts[posts.length - 1]?.data.pubDate.getFullYear();
const last = latest?.data.pubDate.getFullYear();
---

<Base>
  <section class="hero">
    <p class="hero-kicker">GAME DIARY</p>
    <h1>ハジエッセイ<span>要は日記</span></h1>
    <p class="hero-lead">モンハンエクスプロアやシノアリスを遊びながら書いた、攻略メモと日記。</p>
    <p class="hero-stats">
      <span><b>{posts.length}</b> 記事</span>
      <span><b>{first === last ? first : `${first}–${last}`}</b></span>
    </p>
  </section>

  {latest && (
    <section class="latest" aria-label="いちばん新しい記事">
      <PostCard post={latest} featured />
    </section>
  )}

  <section class="filters" aria-label="絞り込み">
    <div class="row" role="group" aria-label="ゲームで絞り込む">
      <button type="button" class="f-game" data-game="" aria-pressed="true">すべて <small>{posts.length}</small></button>
      {games.map((g) => (
        <button type="button" class="f-game" data-game={g.key} aria-pressed="false" style={`--hue:${g.hue}`}>
          {g.label} <small>{g.count}</small>
        </button>
      ))}
    </div>
    <div class="row cats" role="group" aria-label="カテゴリで絞り込む">
      {cats.map((c) => <button type="button" class="f-cat" data-cat={c} aria-pressed="false">#{c}</button>)}
    </div>
  </section>

  <section class="grid" aria-label="記事の一覧">
    {rest.map((p) => <PostCard post={p} />)}
  </section>
  <p class="empty" hidden>この条件の記事はありません。</p>
</Base>

<script>
  // ゲーム（?game=）とカテゴリで一覧を絞る。いちばん新しい記事のカードも同じ条件で隠す
  const params = new URLSearchParams(location.search);
  let game = params.get('game') ?? '';
  let cat = '';
  const gameButtons = document.querySelectorAll<HTMLButtonElement>('.f-game');
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.f-cat');
  const cards = document.querySelectorAll<HTMLElement>('.card');
  const empty = document.querySelector<HTMLElement>('.empty')!;

  function apply() {
    gameButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.game ?? '') === game)));
    catButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
    let shown = 0;
    cards.forEach((c) => {
      const ok = (!game || c.dataset.game === game) && (!cat || (c.dataset.cats ?? '').split('|').includes(cat));
      (c.parentElement?.classList.contains('latest') ? c.parentElement : c).hidden = !ok;
      if (ok) shown++;
    });
    empty.hidden = shown > 0;
    const url = new URL(location.href);
    game ? url.searchParams.set('game', game) : url.searchParams.delete('game');
    history.replaceState(null, '', url);
  }
  gameButtons.forEach((b) => b.addEventListener('click', () => { game = b.dataset.game ?? ''; apply(); }));
  catButtons.forEach((b) => b.addEventListener('click', () => { cat = cat === b.dataset.cat ? '' : (b.dataset.cat ?? ''); apply(); }));
  apply();
</script>

<style>
  .hero { padding: 56px 0 32px; }
  .hero-kicker { margin: 0; font-size: 0.75rem; letter-spacing: 0.3em; color: var(--accent); font-weight: 700; }
  .hero h1 {
    margin: 6px 0 10px; font-family: 'Dela Gothic One', sans-serif; font-weight: 400;
    font-size: clamp(2.2rem, 7vw, 3.6rem); line-height: 1.15; letter-spacing: 0.04em;
  }
  .hero h1 span { display: block; font-family: 'Zen Kaku Gothic New', sans-serif; font-size: 0.32em; font-weight: 500; color: var(--muted); letter-spacing: 0.3em; margin-top: 8px; }
  .hero-lead { margin: 0; color: var(--muted); max-width: 36em; }
  .hero-stats { display: flex; gap: 20px; margin: 18px 0 0; color: var(--muted); font-size: 0.9rem; }
  .hero-stats b { color: var(--fg); font-size: 1.2rem; margin-right: 4px; font-variant-numeric: tabular-nums; }

  .latest { margin-bottom: 36px; }

  .filters { display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .row { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button {
    font: inherit; font-size: 0.85rem; cursor: pointer; padding: 5px 14px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
  }
  .filters button small { color: var(--muted); margin-left: 2px; }
  .f-game[style][aria-pressed='true'] { background: hsl(var(--hue) 70% var(--light)); border-color: transparent; color: #fff; }
  .f-game:not([style])[aria-pressed='true'], .f-cat[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: transparent; }
  .filters button[aria-pressed='true'] small { color: inherit; opacity: 0.8; }
  .cats button { font-size: 0.78rem; padding: 3px 12px; color: var(--muted); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 22px; }
  .empty { color: var(--muted); text-align: center; padding: 40px 0; }
</style>
