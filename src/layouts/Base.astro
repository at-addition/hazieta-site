---
// フォントは Google から読まずに、このサイトから出す（@fontsource。文字の範囲ごとに分かれていて、使う分だけ読まれる）
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/dela-gothic-one/400.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import { GAMES } from '../lib/games';
// 当時のタイトル画像（ハジエッセイ｜要は日記・www.hazieta.com とうさぎ）。元の PNG をなぞって SVG にしたもの。
// 黒は文字色、うさぎの目の白は背景の色に合わせる
import titleLogo from '../assets/hazieta-title.svg?raw';

interface Props {
  title?: string;
  description?: string;
  /** SNS で共有したときに出す画像（サイトからの絶対パスか URL）。無ければサイトのアイコン */
  image?: string;
  /** 記事のページなら 'article' */
  type?: 'website' | 'article';
  /** 検索エンジン向けの構造化データ（JSON-LD）。無ければサイト全体（WebSite）の分を出す */
  jsonld?: Record<string, unknown>;
}
const SITE_NAME = 'ハジエッセイ';
const TAGLINE = '要は日記';
const { title, description = 'モンハンエクスプロアやシノアリスなど、ゲームの日記', image, type = 'website', jsonld } = Astro.props;
const base = import.meta.env.BASE_URL;
// 検索と SNS 向け。正規の URL と、共有したときのタイトル・説明・画像
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? `${base}icon-512.png`, Astro.site).href;
const ld = jsonld ?? { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: new URL(base, Astro.site).href, inLanguage: 'ja' };
// 検索結果とブラウザのタブに出すタイトル。昔の記事はタイトルが長い（170字近いものもある）ので、
// 40字を超えたら区切りのよいところで切る（記事の見出しはそのまま）
const shortTitle = (s: string) => {
  if (s.length <= 40) return s;
  const cut = s.slice(0, 40);
  const i = Math.max(cut.lastIndexOf(' '), cut.lastIndexOf('　'), cut.lastIndexOf('【'), cut.lastIndexOf('・'));
  return (i >= 24 ? cut.slice(0, i) : cut).trimEnd() + '…';
};
// 翻訳ボタン: 押すと Google 翻訳でこのページを英語・繁体字中国語・韓国語にして開く（外部の部品は読み込まず、リンクだけ）。
// 中国語は台湾・香港向けの繁体字（本土は Google の広告が出ないため。2026-10-27）
const translate = (tl: string) => `https://translate.google.com/translate?sl=ja&tl=${tl}&u=${encodeURIComponent(canonical)}`;
const pageTitle = title ? `${shortTitle(title)} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`${base}rss.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <!-- 当時のロゴが黒地に白なので、サイトは常に暗い画面にする（ゲームの画面写真も映える） -->
    <meta name="color-scheme" content="dark" />
    <!-- ブラウザのタブは顔だけのうさぎ（SVG）、スマホのホーム画面とブックマークは当時のサイトアイコン（体付きのうさぎ M2） -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#0b0b0e" />
    <title>{title ? pageTitle : `${SITE_NAME} – ${TAGLINE}`}</title>
  </head>
  <body>
    <div class="bg-glow" aria-hidden="true"></div>
    <header class="site-header">
      <div class="inner">
        <a class="logo" href={base} aria-label={`${SITE_NAME} – ${TAGLINE}`}>
          <span class="logo-title" set:html={titleLogo} />
        </a>
        <nav class="site-nav" aria-label="ゲーム">
          {GAMES.map((g) => (
            <a href={`${base}?game=${g.key}`} style={`--hue:${g.hue}`}><span class="dot"></span>{g.short}</a>
          ))}
        </nav>
      </div>
    </header>
    <nav class="translate" aria-label="翻訳" translate="no">
      <a href={translate('en')} rel="nofollow noopener" lang="en">English</a>
      <a href={translate('zh-TW')} rel="nofollow noopener" lang="zh-TW">繁體中文</a>
      <a href={translate('ko')} rel="nofollow noopener" lang="ko">한국어</a>
    </nav>
    <script is:inline>
      // 翻訳されたページ（*.translate.goog）の中では、Google がボタンのリンクを書き換えて「Can't translate this page」になる。
      // そこでは押したときに、今の翻訳ページの言語（_x_tr_tl）だけを差し替えて開き直す（2026-10-27）
      if (location.hostname.endsWith('.translate.goog')) {
        document.querySelectorAll('.translate a').forEach((a) => a.addEventListener('click', (e) => {
          e.preventDefault();
          const u = new URL(location.href);
          u.searchParams.set('_x_tr_tl', a.getAttribute('lang'));
          location.href = u.href;
        }));
      }
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="inner">
        <span class="hud">HAZIETA.COM // GAME DIARY</span>
        <p>© {SITE_NAME} – {TAGLINE}</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b0b0e;
    --surface: #15151b;
    --surface-2: #1c1c24;
    --fg: #ecebf0;
    --muted: #9b99a8;
    --line: rgb(255 255 255 / 8%);
    --accent: hsl(18 95% 58%);
    --shadow: 0 1px 0 rgb(255 255 255 / 4%) inset, 0 12px 32px rgb(0 0 0 / 45%);
    --radius: 16px;
    /* ゲームの色（--hue と組み合わせる） */
    --sat: 92%;
    --light: 62%;
    --tint: 16%;
    --hud: 'Chakra Petch', 'Zen Kaku Gothic New', sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: 'Zen Kaku Gothic New', system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic UI', sans-serif;
    line-height: 1.85;
    letter-spacing: 0.02em;
    position: relative;
    overflow-x: hidden;
  }
  /* 背景にゲームの色のぼんやりした光と、細い方眼 */
  .bg-glow {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60vw 50vh at 85% -10%, hsl(18 95% 50% / 18%), transparent 60%),
      radial-gradient(50vw 45vh at -10% 30%, hsl(285 90% 55% / 14%), transparent 60%),
      linear-gradient(rgb(255 255 255 / 2.5%) 1px, transparent 1px) 0 0 / 100% 48px,
      linear-gradient(90deg, rgb(255 255 255 / 2.5%) 1px, transparent 1px) 0 0 / 48px 100%;
  }
  a { color: var(--accent); }
  img { max-width: 100%; height: auto; }
  .inner, main { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  ::selection { background: hsl(18 95% 58% / 40%); }

  /* ヘッダー */
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: rgb(11 11 14 / 72%);
    backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .site-header .inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; flex-wrap: wrap; }
  .logo { display: flex; align-items: center; text-decoration: none; color: var(--fg); padding: 8px 0; }
  .logo-title { display: block; width: clamp(180px, 42vw, 230px); }
  .logo-title svg { display: block; width: 100%; height: auto; --logo-hole: var(--bg); }
  .site-nav { display: flex; gap: 6px; flex-wrap: wrap; padding: 8px 0; }
  .site-nav a {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--hud); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-decoration: none;
    padding: 5px 12px; border-radius: 8px; color: var(--fg);
    border: 1px solid var(--line); background: rgb(255 255 255 / 3%);
    transition: border-color 0.2s, background 0.2s;
  }
  .site-nav a:hover { border-color: hsl(var(--hue) var(--sat) var(--light) / 60%); background: hsl(var(--hue) 80% 50% / 10%); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: hsl(var(--hue) var(--sat) var(--light)); box-shadow: 0 0 8px hsl(var(--hue) var(--sat) var(--light)); }

  /* フッター */
  .site-footer { margin-top: 88px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
  .site-footer .inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 24px; padding-bottom: 40px; flex-wrap: wrap; }
  .site-footer p { margin: 0; }
  .hud { font-family: var(--hud); font-weight: 700; letter-spacing: 0.2em; font-size: 0.75rem; color: var(--muted); }

  /* ゲームのバッジ（--hue を付けて使う） */
  .game-badge {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--hud); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
    padding: 2px 9px; border-radius: 6px;
    color: hsl(var(--hue) var(--sat) var(--light));
    background: hsl(var(--hue) 80% 50% / var(--tint));
    border: 1px solid hsl(var(--hue) var(--sat) var(--light) / 35%);
  }
  .chip {
    display: inline-block; font-size: 0.75rem; color: var(--muted);
    border: 1px solid var(--line); padding: 1px 10px; border-radius: 6px;
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
  .translate { display: flex; justify-content: flex-end; gap: 6px; max-width: 1120px; margin: 6px auto 0; padding: 0 16px; box-sizing: border-box; }
  .translate a { font-size: 0.75rem; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); text-decoration: none; }
  .translate a:hover { color: var(--fg); border-color: var(--fg); }
</style>
